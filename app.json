{
  "expo": {
    "name": "txt",
    "slug": "txt",
    "scheme": "txt",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/txt-s500.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/txt-s500.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/txt-s500.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.barryallen16.offtxt",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SEND_SMS",
        "android.permission.READ_SMS",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to read your location so you can text it to a contact.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to share your live location with a contact while sharing is on.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to pick a photo to send."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to read your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save received pictures.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-build-properties",
      "expo-notifications",
      "./withAndroidAllowBackup",
      "./withNotificationListener",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b48109c0-ae65-467e-931e-295f203a59c9"
      }
    },
    "owner": "barryallen16"
  }
}
